# GEMINI_API_KEY: Optional for live Gemini AI calls.
# Without this key, DevScope uses the built-in offline analysis fallback.
GEMINI_API_KEY=your_gemini_key_here

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=http://localhost:3000

# GITHUB_TOKEN: Optional GitHub Personal Access token to prevent rate limits on profile audits.
GITHUB_TOKEN=your_github_token_here
